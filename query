| rex field=_raw max_match=0 "Account Domain:\s+(?<dom_list>[^\t\r\n]+?)\s*(?=\t|Logon ID:)"
| rex field=_raw max_match=0 "Logon ID:\s+(?<lid_list>0x[0-9A-Fa-f]+)"
| eval TargetUser=mvindex(acct_list,-1)
| eval TargetDomain=mvindex(dom_list,-1)
| eval LogonId=mvindex(lid_list,-1)
