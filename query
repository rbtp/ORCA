  match(_raw, "(?i)\bsnort\b|\[\d+:\d+:\d+\]"),           "snort",
  match(_raw, "(?i)\bsuricata\b"),                        "suricata",

  /* ---------- Infrastructure ---------- */
  match(_raw, "(?i)\bvmkernel|\bhostd\[|\bvpxa\["),       "vmware:esxlog",
  match(_raw, "(?i)\bnamed\[\d+\]:|\bbind\b.*\bquery:"),  "isc:bind",
  match(_raw, "(?i)\bdhcpd\[\d+\]:"),                     "isc:dhcpd",
  match(_raw, "(?i)\bNetApp\b|\bONTAP\b"),                "netapp",
  match(_raw, "(?i)\bAPC\b|\bUPS\b.*\bOn Battery"),       "apc:ups",
  match(_raw, "(?i)\biDRAC\b|\bilo\d?\b"),                "oob:mgmt",

  /* ---------- Generic formats (must be LAST: they match broadly) ---------- */
  match(_raw, "^CEF:\d\|([^|]*)\|"),                      "cef:unmapped",
  match(_raw, "^LEEF:\d"),                                "leef:unmapped",
  match(_raw, "^<\d{1,3}>\d\s\d{4}-\d{2}-\d{2}T"),        "rfc5424:unmapped",
