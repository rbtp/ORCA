index=<your_index> sourcetype=syslog
| eval vendor=case(

  /* ---------- Network: firewalls ---------- */
  match(_raw, "%ASA-\d+-\d{6}"),                          "cisco:asa",
  match(_raw, "%FTD-\d+-\d{6}"),                          "cisco:ftd",
  match(_raw, "%FWSM-\d+-\d{6}"),                         "cisco:fwsm",
  match(_raw, "(?i)\bPAN-OS\b|,(TRAFFIC|THREAT|SYSTEM|CONFIG|HIPMATCH|GLOBALPROTECT|USERID|DECRYPTION),"), "pan:log",
  match(_raw, "(?i)\bdevice_id=\d+\s+log_id=|\btype=(traffic|utm|event)\b.*\bsubtype="), "fortinet:fortigate",
  match(_raw, "(?i)id=\"?firewall\"?\s+sn=|\bmsg=\"?Connection (Opened|Closed)"), "sonicwall",
  match(_raw, "(?i)\bdevname=.*\bvd=root\b"),             "fortinet:fortigate",
  match(_raw, "(?i)\bCEF:\d\|(Check Point|CheckPoint)"),  "checkpoint",
  match(_raw, "(?i)\bsrc=.*\bdst=.*\baction=(accept|drop|reject)\b.*\bproduct="), "checkpoint",
  match(_raw, "(?i)^\s*\w+\s+\d+\s[\d:]+\s\S+\s(filterlog|pf):"), "pfsense",
  match(_raw, "(?i)\bJuniper\b|RT_FLOW_SESSION_(CREATE|CLOSE|DENY)"), "juniper:junos",

  /* ---------- Network: routing, switching, wireless ---------- */
  match(_raw, "%(LINK|LINEPROTO|SYS|SEC|PARSER|IP|OSPF|BGP|SPANTREE|DOT11|DHCPD)-\d+-\w+:"), "cisco:ios",
