  match(_raw, "(?i)\bpalo.*GlobalProtect|GLOBALPROTECT,"), "pan:globalprotect",

  /* ---------- Windows ---------- */
  match(_raw, "(?i)\bEventCode=\d+|\bEventID[=:\s]+\d+"), "windows:eventlog",
  match(_raw, "(?i)LogName=Security|\bSource Network Address:"), "windows:security",
  match(_raw, "(?i)\bMSWinEventLog\b"),                   "windows:snare",
  match(_raw, "(?i)\bWinCollect\b"),                      "windows:wincollect",

  /* ---------- Unix / Linux ---------- */
  match(_raw, "sshd\[\d+\]:"),                            "linux:sshd",
  match(_raw, "sudo:\s+\S+\s*:\s*(TTY|PWD)="),            "linux:sudo",
  match(_raw, "(?i)\b(audispd|audit)\[\d+\]|\btype=(SYSCALL|USER_AUTH|EXECVE)\b"), "linux:auditd",
  match(_raw, "(CRON|cron)\[\d+\]:"),                     "linux:cron",
  match(_raw, "kernel:\s*\["),                            "linux:kernel",
  match(_raw, "(?i)\bsystemd\[\d+\]:"),                   "linux:systemd",

  /* ---------- Web / proxy / load balancer ---------- */
  match(_raw, "\"(GET|POST|PUT|DELETE|HEAD|OPTIONS|PATCH)\s+\S+\s+HTTP/\d"), "web:access_combined",
  match(_raw, "(?i)\bnginx\b"),                           "nginx",
  match(_raw, "(?i)\bhaproxy\[\d+\]:"),                   "haproxy",
  match(_raw, "(?i)\bsquid\b|TCP_(MISS|HIT|DENIED)"),     "squid",
  match(_raw, "(?i)\bZscaler\b|\bZIA\b"),                 "zscaler",
  match(_raw, "(?i)\bBlueCoat|\bProxySG\b"),              "bluecoat:proxysg",
  match(_raw, "(?i)\bF5\b|\bBIG-IP\b|tmm\d*\["),          "f5:bigip",

  /* ---------- Email ---------- */
  match(_raw, "postfix/\w+\[\d+\]:"),                     "postfix",
  match(_raw, "(?i)\bsendmail\[\d+\]:"),                  "sendmail",
  match(_raw, "(?i)\bMailScanner|\bIronPort\b|\bESA\b.*MID \d+"), "cisco:esa",
  match(_raw, "(?i)\bProofpoint\b"),                      "proofpoint",

  /* ---------- Identity / directory ---------- */
  match(_raw, "(?i)\bCISE_\w+|\bCiscoISE\b"),             "cisco:ise",
