# ── Required ─────────────────────────────────────────────────────────────────
# Generate a random 64-char hex value for each of these (JWT_SECRET and
# DB_PASSWORD must be DIFFERENT values -- generate it twice, don't reuse one).
#   With Python:      python -c "import secrets; print(secrets.token_hex(32))"
#   Without Python, in PowerShell (works on both Windows PowerShell 5.1 and
#   PowerShell 7+ -- the newer RandomNumberGenerator::Fill() static method
#   only exists on 7+, so this uses the older RNGCryptoServiceProvider
#   instead, which works on both):
#     $rng = New-Object System.Security.Cryptography.RNGCryptoServiceProvider
#     $b = New-Object byte[] 32; $rng.GetBytes($b)
#     ($b | ForEach-Object { $_.ToString('x2') }) -join ''
JWT_SECRET=change-this-to-a-random-secret

# PostgreSQL password (must match POSTGRES_PASSWORD in this file)
DB_PASSWORD=change-this-to-a-random-password

# ── TLS ───────────────────────────────────────────────────────────────────────
# Auto-generated by backend/entrypoint.sh on first boot — no manual cert needed
TLS_CERT_PATH=/app/certs/orca.crt
TLS_KEY_PATH=/app/certs/orca.key

# ── Network ───────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed by CORS (the URL(s) analysts browse to)
CORS_ORIGINS=https://localhost

# Public base URL of ORCA (used in agent deploy packages; auto-detected if unset)
# ORCA_SERVER_URL=https://your-server-ip

# VirusTotal API key — enables the background hash-lookup worker (checks
# hashes surfaced by the AMCACHE and SUSPICIOUS_LOCATIONS_HASH collection
# techniques). Worker no-ops entirely if unset. Respects the free-tier rate
# limit by default (VT_RATE_LIMIT_SECONDS, default 16s between lookups).
# Existing verdicts get re-checked after VT_RECHECK_DAYS (default 30) once
# there's nothing new left to look up, since detection coverage grows over
# time -- a hash that was clean a month ago may not be anymore.
# VT_API_KEY=your-virustotal-api-key
# VT_RECHECK_DAYS=30

# ── Frontend ──────────────────────────────────────────────────────────────────
# Leave empty for same-origin API calls (nginx proxies /api/ to the backend)
VITE_API_URL=

# ── First-boot admin account ──────────────────────────────────────────────────
# A fresh database has no users and no way to log in until one exists. On
# first boot, if the users table is empty, ORCA creates exactly one admin
# account automatically and never touches this again afterward. Leave these
# unset and a random password is generated and printed ONCE to
# `docker logs orca-backend` (search for "FIRST-BOOT ADMIN ACCOUNT
# CREATED") -- or set them here for a scripted/non-interactive deploy:
# ORCA_BOOTSTRAP_ADMIN_USERNAME=admin
# ORCA_BOOTSTRAP_ADMIN_PASSWORD=set-a-real-password-if-you-set-this-at-all
# ORCA_BOOTSTRAP_ADMIN_INITIALS=ADM

# ── Optional binary overrides ────────────────────────────────────────────────
# ORCA_VOL3_BASE=/app/bin/remora/volatility3
# ORCA_WINPMEM_BASE=/app/bin/remora/volatility3
# ORCA_CLAM_BASE=/app/bin/clamav
