# Files that run inside Linux containers must keep LF endings even when
# cloned on Windows with core.autocrlf=true -- a CRLF entrypoint.sh fails
# with "/bin/sh^M: not found", and CRLF in seed_data COPY rows puts a
# stray \r into the last column of every row.
*.sh            text eol=lf
*.sql           text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
*.py            text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows-only scripts
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
