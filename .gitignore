# Environment secrets — never commit
.env
*.env

# TLS certificates and keys
orca.crt
orca.key
*.crt
*.key
*.pem

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
venv/
.venv/

# Node
node_modules/
frontend/node_modules/

# Frontend build output
frontend/dist/

# ClamAV signature definitions -- updated by freshclam at runtime, not
# vendored (large, frequently stale the moment they're committed). The
# ClamAV engine itself, Velociraptor, Grype/Syft, Arsenal, Volatility3 (incl.
# its symbol tables) etc. under backend/bin/ ARE committed -- ORCA is meant
# to be self-contained on a disconnected network except for these
# definitions and the MITRE ATT&CK JSON import (see backend/data/).
backend/bin/clamav/**/*.cvd
backend/bin/clamav/**/*.cld
backend/bin/clamav/**/*.sign
backend/bin/clamav/**/freshclam.dat

# Logs
*.log
claude_logs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Docker build artifacts
*.tar

# Temp / generated
tmp/
sandbox_*/
