# Environment secrets — never commit
.env
*.env

# TLS certificates and keys
orca.crt
orca.key
*.crt
*.key
*.pem

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
venv/
.venv/

# Node
node_modules/
frontend/node_modules/

# Frontend build output
frontend/dist/

# ClamAV signature definitions under backend/bin/clamav/ (*.cvd, *.cvd.sign,
# certs/clamav.crt) ARE committed, so a fresh clone can scan with no internet
# (they go to agents inside clamav.zip). Refresh them with freshclam and
# re-commit periodically. Only freshclam's own local state file is excluded.
backend/bin/clamav/**/freshclam.dat
# ClamAV's public signature-verification cert, not a secret (*.crt is
# otherwise ignored above).
!backend/bin/clamav/certs/clamav.crt

# Generated at request time by agent_routes.py from the already-committed
# backend/bin/arsenal/ directory -- a pre-built zip of it exceeds GitHub's
# 100MB single-file limit, so it's never committed, only cached in /tmp.
backend/bin/arsenal.zip

# MITRE ATT&CK STIX bundle (backend/data/mitre-attack.json) IS committed
# (~52 MB) so a fresh install imports ATT&CK on first boot with no download.

# Logs
*.log
backend_stdout.log
backend_stderr.log
claude_logs/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Docker build artifacts
*.tar

# Temp / generated
tmp/
sandbox_*/

# Grype vulnerability DB -- ~3 GB (vulnerability.db alone exceeds GitHub's
# 100MB single-file limit by ~30x). Operator-populated at deploy time on a
# connected machine (see docs/ADMIN_GUIDE.md, "Grype Vulnerability
# Database"); config.py's GRYPE_DB_DIR points grype here, and
# agent_routes.py serves it to agents as grype-db.zip.
backend/bin/syftgrype/grype-db/
